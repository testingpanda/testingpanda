# ---------------------------------------------------------------------------
# Geneva Tax Declaration MVP — environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
# All values are validated at boot by src/lib/env.ts — the app refuses to
# start with missing/malformed configuration instead of failing silently.
# ---------------------------------------------------------------------------

# --- Core app ---------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
# Used for AES-256-GCM at-rest encryption of stored files and select DB fields.
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Used to sign session cookies (JWT, HS256). Generate with: openssl rand -base64 32
SESSION_SECRET=

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql://tax:tax@localhost:5432/geneva_tax_mvp?schema=public

# --- File storage --------------------------------------------------------------
# "local" for development, "s3" for an S3-compatible encrypted object store in production.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage-dev
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=false
# Seconds a generated download URL / token stays valid.
STORAGE_SIGNED_URL_TTL_SECONDS=120

# --- LLM provider --------------------------------------------------------------
# "mock" runs a fully deterministic, offline extraction engine — no API key
# required. Use it for local dev, demos, and CI. Switch to "openai" or
# "anthropic" for real document understanding.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- OCR ------------------------------------------------------------------------
# "stub" returns a low-confidence placeholder and flags the page for manual
# review — safe default with no network/model dependency. "tesseract" performs
# real OCR (requires the tesseract.js worker + language data to be reachable).
OCR_PROVIDER=stub

# --- Malware scanning ------------------------------------------------------------
# "stub" always reports files clean in development. Wire a real scanner
# (e.g. ClamAV daemon) via MALWARE_SCAN_PROVIDER=clamav in production.
MALWARE_SCAN_PROVIDER=stub
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- Uploads ----------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=25

# --- Rate limiting -----------------------------------------------------------------
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_UPLOAD_MAX=30
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=300

# --- Seed / demo mode -----------------------------------------------------------
# When true, `npm run seed` creates a demo user + fully populated mock tax case.
SEED_DEMO_MODE=true
SEED_DEMO_EMAIL=demo@example.com
SEED_DEMO_PASSWORD=DemoPassword123!
